//@version=6
strategy("9 AM Multi-Timeframe Sell Strategy", overlay=true, 
         initial_capital=10000, default_qty_type=strategy.percent_of_equity, 
         default_qty_value=10, commission_type=strategy.commission.percent, 
         commission_value=0.1, max_bars_back=5000)

// ============================================================================
// SECTION 1: INPUT PARAMETERS
// ============================================================================
// User-configurable settings for strategy customization

// Session Settings
session_timezone = input.string("America/New_York", "Session Timezone", tooltip="Timezone for 9 AM session identification (EST)")

// Key Level Detection Settings
key_level_lookback = input.int(20, "4H Key Level Lookback", minval=5, maxval=100,tooltip="Number of 4H candles to scan for key levels")

fvg_min_size_atr = input.float(0.5, "FVG Minimum Size (ATR)", minval=0.1, maxval=3.0, step=0.1,tooltip="Minimum FVG size as ATR multiplier on 4H")

order_block_strength = input.int(3, "Order Block Strength", minval=2, maxval=10, tooltip="Number of bars for order block validation")

// Entry Settings
crt_confirmation_bars = input.int(2, "CRT Confirmation Bars", minval=1, maxval=5,tooltip="Number of 15m bars to confirm Change of Trend")

retest_tolerance_percent = input.float(0.3, "Retest Tolerance %", 
                                       minval=0.1, maxval=2.0, step=0.1,
                                       tooltip="Percentage tolerance for key level retest")

// Risk Management
use_stop_loss = input.bool(true, "Use Stop Loss")
sl_buffer_atr = input.float(0.2, "Stop Loss Buffer (ATR)", minval=0.0, maxval=1.0, step=0.1,tooltip="Additional buffer above 4H key level for SL")

use_take_profit = input.bool(true, "Use Take Profit")
tp_buffer_atr = input.float(0.1, "Take Profit Buffer (ATR)", minval=0.0, maxval=1.0, step=0.1,tooltip="Buffer below 9 AM low for TP")

// Visualization
show_9am_levels = input.bool(true, "Show 9 AM Levels")
show_4h_key_levels = input.bool(true, "Show 4H Key Levels")
show_fvg = input.bool(true, "Show Fair Value Gaps")
show_order_blocks = input.bool(true, "Show Order Blocks")

// ============================================================================
// SECTION 2: MULTI-TIMEFRAME DATA REQUEST
// ============================================================================
// Request data from higher timeframes (1H and 4H) for analysis
// Pine Script's security() function fetches data from different timeframes

// Request 1-hour data for 9 AM candle identification
h1_time = request.security(syminfo.tickerid, "60", time)
h1_high = request.security(syminfo.tickerid, "60", high)
h1_low = request.security(syminfo.tickerid, "60", low)
h1_close = request.security(syminfo.tickerid, "60", close)
h1_open = request.security(syminfo.tickerid, "60", open)

// Request 4-hour data for key level identification
h4_high = request.security(syminfo.tickerid, "240", high)
h4_low = request.security(syminfo.tickerid, "240", low)
h4_close = request.security(syminfo.tickerid, "240", close)
h4_open = request.security(syminfo.tickerid, "240", open)
h4_atr = request.security(syminfo.tickerid, "240", ta.atr(14))

// Current timeframe ATR (should be 15m)
current_atr = ta.atr(14)

// ============================================================================
// SECTION 3: 9 AM SESSION IDENTIFICATION
// ============================================================================
// Identify the 9 AM EST candle on the 1-hour timeframe
// This candle's high and low become our key reference points

// Convert current bar time to the specified timezone
bar_time = time(timeframe.period, "0900-1000", session_timezone)

// Detect if current bar is the 9 AM hour (in EST)
is_9am_hour = not na(bar_time)

// Store the 9 AM 1-hour candle high and low
var float nine_am_high = na
var float nine_am_low = na
var int nine_am_bar = na
var bool nine_am_set_today = false

// Get current day for daily reset
current_day = dayofweek

// Reset daily flag when new day starts
if current_day != current_day[1]
    nine_am_set_today := false

// When 9 AM hour is detected on 1H chart, store the levels
if is_9am_hour and not nine_am_set_today
    nine_am_high := h1_high
    nine_am_low := h1_low
    nine_am_bar := bar_index
    nine_am_set_today := true

// ============================================================================
// SECTION 4: 4-HOUR KEY LEVEL IDENTIFICATION
// ============================================================================
// Identify key institutional levels on the 4-hour timeframe
// These include: FVG, IFVG, Order Blocks, and Liquidity zones

// -----------------------------
// 4A: FAIR VALUE GAP (FVG) DETECTION
// -----------------------------
// Bearish FVG: A downward gap where high[2] > low[0]
// This represents an inefficiency that price may return to fill

// Detect bearish FVG on 4H (gap down)
bearish_fvg_4h = request.security(syminfo.tickerid, "240", 
                 low[2] > high and (low[2] - high) >= (h4_atr * fvg_min_size_atr))

// Store most recent bearish FVG zone
var float fvg_top = na
var float fvg_bottom = na
var int fvg_bar_index = na
var bool fvg_active = false

if bearish_fvg_4h and (not fvg_active or bar_index - fvg_bar_index > 50)
    fvg_top := request.security(syminfo.tickerid, "240", low[2])
    fvg_bottom := request.security(syminfo.tickerid, "240", high)
    fvg_bar_index := bar_index
    fvg_active := true

// Deactivate FVG if price fills it completely or it's too old
if fvg_active and (low < fvg_bottom or bar_index - fvg_bar_index > 200)
    fvg_active := false

// -----------------------------
// 4B: ORDER BLOCK DETECTION
// -----------------------------
// Order Block: Last up-candle before a strong down move (bearish OB)
// Represents institutional selling area

// Detect bearish order blocks on 4H
// Logic: Find bullish candle followed by strong bearish move
var float ob_top = na
var float ob_bottom = na
var bool ob_active = false
var int ob_bar_index = na

// Request 4H candle sequence for order block detection
h4_bullish = request.security(syminfo.tickerid, "240", close > open)
h4_bearish_strength = request.security(syminfo.tickerid, "240", 
                      open - close > (close[1] - open[1]) * 1.5)

// Identify order block: bullish candle followed by strong bearish candle
order_block_detected = h4_bullish[1] and h4_bearish_strength

if order_block_detected and (not ob_active or bar_index - ob_bar_index > 50)
    ob_top := request.security(syminfo.tickerid, "240", high[1])
    ob_bottom := request.security(syminfo.tickerid, "240", low[1])
    ob_bar_index := bar_index
    ob_active := true

// Deactivate if price breaks below order block or too old
if ob_active and (low < ob_bottom * 0.995 or bar_index - ob_bar_index > 200)
    ob_active := false

// -----------------------------
// 4C: LIQUIDITY ZONES
// -----------------------------
// Liquidity = Swing highs where stop losses cluster
// These are magnets for institutional players

var float liquidity_high = na
var int liquidity_bar = na

// Find swing highs on 4H (resistance liquidity)
swing_high_4h = request.security(syminfo.tickerid, "240", ta.pivothigh(high, order_block_strength, order_block_strength))

if not na(swing_high_4h)
    liquidity_high := swing_high_4h
    liquidity_bar := bar_index

// -----------------------------
// 4D: COMBINED KEY LEVEL ZONES
// -----------------------------
// Combine all 4H key levels into unified zones for entry logic

// Determine if we have valid key levels
have_fvg = fvg_active and not na(fvg_top)
have_ob = ob_active and not na(ob_top)
have_liquidity = not na(liquidity_high) and bar_index - liquidity_bar < 100

// Create combined resistance zone from key levels
var float key_zone_top = na
var float key_zone_bottom = na
var bool key_zone_active = false

// Prioritize: FVG > Order Block > Liquidity
if have_fvg
    key_zone_top := fvg_top
    key_zone_bottom := fvg_bottom
    key_zone_active := true
else if have_ob
    key_zone_top := ob_top
    key_zone_bottom := ob_bottom
    key_zone_active := true
else if have_liquidity
    key_zone_top := liquidity_high + (h4_atr * 0.2)
    key_zone_bottom := liquidity_high - (h4_atr * 0.2)
    key_zone_active := true

// ============================================================================
// SECTION 5: CHANGE OF TREND (CRT) DETECTION ON 15-MIN
// ============================================================================
// CRT occurs when 15-min candle breaks into the 4H key zone
// We need to see price push INTO the key levels (indicating rejection)

// Check if current 15-min price is breaking into key zone
price_in_key_zone = key_zone_active and high >= key_zone_bottom and high <= key_zone_top

// Track when price first enters the key zone
var bool price_entered_zone = false
var int zone_entry_bar = na
var int crt_confirmation_count = 0

if price_in_key_zone and not price_entered_zone
    price_entered_zone := true
    zone_entry_bar := bar_index
    crt_confirmation_count := 0

// Count consecutive bars in/near the zone for confirmation
if price_entered_zone
    if high >= key_zone_bottom * 0.997  // Allow small tolerance
        crt_confirmation_count += 1
    else
        crt_confirmation_count := 0

// CRT confirmed when price has been in zone for required bars
crt_confirmed = crt_confirmation_count >= crt_confirmation_bars

// ============================================================================
// SECTION 6: RETEST AND ENTRY LOGIC
// ============================================================================
// After CRT, wait for price to come back DOWN and out of key zone
// This retest and rejection is our sell entry signal

// Price must exit the key zone to the downside for entry
var bool waiting_for_retest_exit = false

if crt_confirmed and not waiting_for_retest_exit
    waiting_for_retest_exit := true

// Entry condition: Price exits key zone downward after CRT
price_exited_zone_down = waiting_for_retest_exit and 
                         close < key_zone_bottom * (1 - retest_tolerance_percent / 100)

// Additional confirmation: downward momentum
bearish_momentum = close < close[1] and close < open

// Combined sell entry condition
sell_condition = price_exited_zone_down and 
                 bearish_momentum and
                 not na(nine_am_low) and
                 key_zone_active and
                 strategy.position_size == 0

// ============================================================================
// SECTION 7: STOP LOSS AND TAKE PROFIT CALCULATION
// ============================================================================
// SL: Place above the 4H key zone top (with buffer)
// TP: Target the 9 AM 1-hour candle low (with buffer)

var float stop_loss_level = na
var float take_profit_level = na

if sell_condition
    // Stop Loss: Top of 4H key zone + buffer
    stop_loss_level := key_zone_top + (current_atr * sl_buffer_atr)
    
    // Take Profit: 9 AM low - buffer
    take_profit_level := nine_am_low - (current_atr * tp_buffer_atr)

// ============================================================================
// SECTION 8: STRATEGY EXECUTION
// ============================================================================
// Execute sell orders when conditions are met

if sell_condition
    strategy.entry("Sell", strategy.short, comment="9AM CRT Sell")
    // Reset flags after entry
    waiting_for_retest_exit := false
    price_entered_zone := false
    crt_confirmation_count := 0

// Exit management
if strategy.position_size < 0  // If in short position
    if use_stop_loss and use_take_profit
        strategy.exit("Exit Sell", "Sell", stop=stop_loss_level, limit=take_profit_level)
    else if use_stop_loss
        strategy.exit("Exit Sell", "Sell", stop=stop_loss_level)
    else if use_take_profit
        strategy.exit("Exit Sell", "Sell", limit=take_profit_level)

// ============================================================================
// SECTION 9: VISUALIZATION
// ============================================================================
// Plot all key levels and zones for visual analysis

// Plot 9 AM levels
plot(show_9am_levels and not na(nine_am_high) ? nine_am_high : na, 
     "9 AM High", color=color.new(color.blue, 50), linewidth=2, style=plot.style_line)
plot(show_9am_levels and not na(nine_am_low) ? nine_am_low : na, 
     "9 AM Low (TP Target)", color=color.new(color.green, 30), linewidth=2, style=plot.style_line)

// Plot 4H key zone
var box key_zone_box = na
if show_4h_key_levels and key_zone_active and not na(key_zone_top)
    // Create box for key zone visualization
    if na(key_zone_box) or bar_index - zone_entry_bar == 1
        key_zone_box := box.new(bar_index - 10, key_zone_top, bar_index + 20, key_zone_bottom,border_color=color.new(color.red, 40),bgcolor=color.new(color.red, 90),border_width=2)
    else
        box.set_right(key_zone_box, bar_index + 20)

// Plot FVG zones
bgcolor(show_fvg and fvg_active ? color.new(color.purple, 95) : na, title="FVG Zone")

// Plot Order Blocks
bgcolor(show_order_blocks and ob_active ? color.new(color.orange, 95) : na, title="Order Block")

// Plot entry signals
plotshape(sell_condition, "Sell Entry", shape.labeldown, 
          location.abovebar, color=color.new(color.red, 0), 
          text="SELL", textcolor=color.white, size=size.normal)

// Plot CRT confirmation
plotshape(crt_confirmed and not crt_confirmed[1], "CRT Confirmed", 
          shape.triangledown, location.abovebar, 
          color=color.new(color.orange, 0), size=size.small)

// Plot stop loss and take profit for active positions
plot(strategy.position_size < 0 ? stop_loss_level : na, "Stop Loss", 
     color=color.new(color.red, 0), linewidth=2, style=plot.style_cross)
plot(strategy.position_size < 0 ? take_profit_level : na, "Take Profit", 
     color=color.new(color.green, 0), linewidth=2, style=plot.style_cross)

// Highlight when price is in key zone
bgcolor(price_in_key_zone ? color.new(color.yellow, 90) : na, title="Price in Key Zone")

// ============================================================================
// SECTION 10: ALERTS
// ============================================================================
// Create alert conditions for automated trading

alertcondition(sell_condition, title="Sell Entry Signal", 
               message="9 AM Strategy: Sell signal - CRT confirmed, retest complete")

alertcondition(crt_confirmed, title="CRT Confirmed", 
               message="Change of Trend confirmed - Watch for retest exit")

alertcondition(price_in_key_zone and not price_in_key_zone[1], title="Price Entered Key Zone", 
               message="Price has entered 4H key zone - Monitor for CRT")

// ============================================================================
// SECTION 11: STRATEGY INFORMATION TABLE
// ============================================================================
// Display current strategy state for debugging

var table info_table = table.new(position.top_right, 2, 8, 
                                 bgcolor=color.new(color.black, 85), 
                                 frame_color=color.gray, 
                                 frame_width=1)

if barstate.islast
    // Header
    table.cell(info_table, 0, 0, "9 AM Strategy Status", 
               text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(info_table, 1, 0, "", bgcolor=color.new(color.blue, 70))
    
    // 9 AM Levels
    table.cell(info_table, 0, 1, "9 AM High", text_color=color.white)
    table.cell(info_table, 1, 1, not na(nine_am_high) ? str.tostring(nine_am_high, "#.##") : "Not Set", 
               text_color=color.white)
    
    table.cell(info_table, 0, 2, "9 AM Low", text_color=color.white)
    table.cell(info_table, 1, 2, not na(nine_am_low) ? str.tostring(nine_am_low, "#.##") : "Not Set", 
               text_color=color.white)
    
    // Key Zone Status
    table.cell(info_table, 0, 3, "Key Zone Active", text_color=color.white)
    table.cell(info_table, 1, 3, key_zone_active ? "YES" : "NO", 
               text_color=key_zone_active ? color.green : color.red)
    
    // CRT Status
    table.cell(info_table, 0, 4, "CRT Confirmed", text_color=color.white)
    table.cell(info_table, 1, 4, crt_confirmed ? "YES" : "NO", 
               text_color=crt_confirmed ? color.green : color.red)
    
    // Waiting Status
    table.cell(info_table, 0, 5, "Waiting Retest", text_color=color.white)
    table.cell(info_table, 1, 5, waiting_for_retest_exit ? "YES" : "NO", 
               text_color=waiting_for_retest_exit ? color.orange : color.gray)
    
    // Position Status
    table.cell(info_table, 0, 6, "Position", text_color=color.white)
    table.cell(info_table, 1, 6, 
               strategy.position_size < 0 ? "SHORT" : strategy.position_size > 0 ? "LONG" : "NONE", 
               text_color=strategy.position_size < 0 ? color.red : 
                         strategy.position_size > 0 ? color.green : color.gray)
    
    // Current Timeframe Warning
    table.cell(info_table, 0, 7, "Suggested TF", text_color=color.yellow)
    table.cell(info_table, 1, 7, "15 min", text_color=color.yellow)

// ============================================================================
// END OF STRATEGY
// ============================================================================

